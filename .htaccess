# Force HTTPS
# Checks both native HTTPS and X-Forwarded-Proto (used when behind a reverse proxy like Traefik).
# Both conditions must be true for the redirect to fire, preventing loops.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Clean URLs for /services/*
#
# Tricky case: /services/candidates exists as BOTH a .php file AND a directory
# (the directory holds /services/candidates/signup.php and /services/candidates/thanks.php).
# Without DirectorySlash Off, Apache's mod_dir would intercept /services/candidates and
# 301-redirect it to /services/candidates/ before mod_rewrite gets a chance, then 403.
DirectorySlash Off

# Index: /services/ -> services/index.php (services catalog page)
RewriteRule ^services/?$ /services/index.php [L]

# Specific: /services/candidates -> services/candidates.php (the marketing landing page)
RewriteRule ^services/candidates/?$ /services/candidates.php [L]

# Nested: /services/candidates/<page> -> services/candidates/<page>.php
# (handles /services/candidates/signup, /services/candidates/thanks, etc.)
RewriteRule ^services/candidates/([a-z0-9-]+)/?$ /services/candidates/$1.php [L]

# Generic: /services/<name> -> services/<name>.php
# Skip if file already exists naturally (e.g. *.php or static asset)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^services/([a-z0-9-]+)/?$ /services/$1.php [L]

# media.html was renamed to media.php (PHP includes for shared header/footer)
# Redirect old URL to new for inbound link preservation
RewriteRule ^media\.html$ /media.php [L,R=301]

# Force www to non-www (optional - uncomment if preferred)
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Prevent directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(env|json|md|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow specific JSON files that need to be public
<FilesMatch "^(projects\.json)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
