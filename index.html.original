  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    AOS.init({
      once: true,
      duration: 800
    });
  });
</script>
</head>
<body>
