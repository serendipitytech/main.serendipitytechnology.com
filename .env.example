# Twilio API Credentials
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Email settings
CONTACT_EMAIL=your@email.com

# Dashboard Authentication
# Set a strong password for accessing the SMS dashboard
DASHBOARD_PASSWORD=your_secure_password_here

# Webhook Secret
# Random string for validating n8n webhook requests
WEBHOOK_SECRET=your_random_secret_here

# Admin Phone
# Phone number to receive SMS alerts for new messages
ADMIN_PHONE=+1XXXXXXXXXX

# Resend Email API
# Get from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Cloudflare Turnstile CAPTCHA
# Get from https://dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
